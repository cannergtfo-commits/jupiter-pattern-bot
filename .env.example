# Copy to .env and adjust. DRY_RUN=true is the safe default — keep it until you intend live trades.
# NEVER commit .env — it is gitignored.

# Solana RPC (public endpoint is rate-limited; use Helius/QuickNode for live)
RPC_URL=https://api.mainnet-beta.solana.com

# Strategy — user defaults for this bot
BUY_AMOUNT_SOL=0.05
MAX_BUY_AMOUNT_SOL=0.15
MAX_PORTFOLIO_BUY_PCT=50
MIN_SOL_RESERVE=0.01
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=20
SLIPPAGE_BPS=100
DRY_RUN=true

# Hold / skill-aligned exits
MAX_HOLD_MINUTES=0
MAX_HOLD_SECONDS=40
POSITION_POLL_MS=5000
EARLY_RED_CUT_MINUTES=3
EARLY_RED_CUT_MAX_PCT=0

# Risk filters (also editable via `bot filters set`)
MAX_TOP_HOLDER_PCT=100
MAX_TOP10_HOLDER_PCT=100
MAX_BUNDLER_PCT=-1
MIN_LIQUIDITY_USD=1000
MIN_VOLUME_24H_USD=0
MIN_VOLUME_SPIKE_RATIO=0
MIN_TOKEN_AGE_MINUTES=5
MAX_TOKEN_AGE_MINUTES=9999999
REQUIRE_MINT_AUTHORITY_REVOKED=false
REQUIRE_FREEZE_AUTHORITY_REVOKED=false

# Optional APIs — run `npm run bot -- setup` to fill interactively
# Jupiter portal: https://portal.jup.ag/
# JUPITER_API_KEY=
# HELIUS_API_KEY=

# Scan loop
SCAN_INTERVAL_MS=30000
MAX_OPEN_POSITIONS=2

# solana-skill pattern gates
MIN_CONFLUENCE_SOURCES=1
MAX_VOLUME_TO_LIQUIDITY_RATIO=40
PREFER_GRADUATED=true
PREFER_PUMP_CALLOUTS=true
RISK_ON_TEST=true
MIN_PATTERN_SCORE=68
MIN_PRICE_CHANGE_5M_PCT=-1
REQUIRE_PREFERRED_PATTERN_TAG=true
PREFERRED_PATTERN_TAGS=maru_bull,3soldiers,hammer,bull_engulf
BLOCKED_PATTERN_TAGS=shoot_star,bear_engulf,maru_bear,3crows,hang_man
REQUIRE_MOMENTUM_PATTERN_TAG=true
MOMENTUM_PATTERN_TAGS=maru_bull,3soldiers
MIN_PREFERRED_TAG_COUNT=2
REENTRY_COOLDOWN_MINUTES=10
REENTRY_VOLUME_PUMP_PCT=15
REENTRY_VOLUME_SPIKE_MIN=3
AUTO_DENYLIST_ON_SL=true
AUTO_DENYLIST_ON_RED_CUT=true
AUTO_DENYLIST_AFTER_LOSSES=2
MAX_ENTRIES_PER_MINT=2

# Optional: encrypt .wallet/keystore.json (scrypt + AES-256-GCM). Leave blank for 0600 keypair.json.
# WALLET_PASSWORD=
