{
  "name": "jupiter-pattern-bot",
  "version": "1.0.0",
  "description": "CLI Solana pattern trader \u2014 YOLO browser long/short (dry-run default) + Jupiter spot, 30s scan / 40s max hold, learn-from-closes",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "jupiter-pattern-bot": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "bot": "node --import tsx src/cli.ts",
    "start": "node dist/cli.js",
    "setup": "node --import tsx src/setup.ts",
    "install:bot": "bash scripts/install.sh",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "init-wallet": "node --import tsx scripts/init-wallet.ts",
    "paper": "node --import tsx scripts/paper-yolo.ts",
    "yolo:dry-run": "node --import tsx scripts/yolo-dry-run.ts",
    "paper:10": "node --import tsx scripts/paper-yolo.ts --minutes 10",
    "paper:15": "node --import tsx scripts/paper-yolo.ts --minutes 15",
    "yolo:probe": "node --import tsx src/cli.ts yolo probe",
    "lessons:merge": "node --import tsx scripts/merge-skill-lessons.ts",
    "test:paper": "node --import tsx --test scripts/test-paper-harness.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "chalk": "5.4.1",
    "commander": "13.1.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "ora": "8.2.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  },
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cannergtfo-commits/jupiter-pattern-bot.git"
  }
}
